<Window x:Class="TimeLapseScreenRecorder.HelpWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="使用帮助"
    Width="480" Height="420"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False">
    <Window.Resources>
        <SolidColorBrush x:Key="BgBase" Color="#0B0D10"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#262E38"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#EDF2F8"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#98A4B0"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B7684"/>
        <SolidColorBrush x:Key="Accent" Color="#7DA3FF"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="HelpCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#C63B3B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#A63232"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgBase}" BorderBrush="#2A313A" BorderThickness="1" CornerRadius="12">
        <Grid Margin="22,16,22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="使用帮助" FontWeight="SemiBold" FontSize="14" Foreground="#E3E9F1"/>
                </StackPanel>
                <Button Style="{StaticResource HelpCloseButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="HelpCloseButton_Click">
                    <Path Data="M0,0 L9,10 M9,0 L0,10" Stroke="#E7EDF5" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="- 本工具的目的为帮助用户记录长时间的屏幕活动" TextWrapping="Wrap" Margin="0,0,0,5" LineHeight="18"/>
                    <TextBlock Text="  例如录制绘画过程的延时视频，这类视频往往体积庞大，记录压力不小" TextWrapping="Wrap" Margin="0,0,0,5" LineHeight="18"/>
                    <TextBlock Text="  而本工具采用截图+后期生成视频的方式，能减轻一些使用负担" TextWrapping="Wrap" Margin="0,0,0,5" LineHeight="18"/>
                    <TextBlock Text="  当然也可以单纯用做一个定时截图的工具" TextWrapping="Wrap" Margin="0,0,0,5" LineHeight="18"/>
                    <TextBlock Text="- 使用分为三个部分：定时截图、图片去重和视频生成，可以随时分开操作" TextWrapping="Wrap" Margin="0,0,0,5" LineHeight="18"/>
                    <TextBlock Text="- “定时截图”顾名思义，就是截取屏幕上的图像，保存在选定的文件夹中" TextWrapping="Wrap" Margin="0,0,0,5" LineHeight="18"/>
                    <TextBlock Text="  “启用计时”用于记录屏幕活动用时，启用后截图的文件名会包含当前计时，可以用来回顾各个环节的用时" TextWrapping="Wrap" Margin="0,0,0,5" LineHeight="18"/>
                    <TextBlock Text="- “图片去重”会删除相邻的重复截图，例如挂机时产生的截图" TextWrapping="Wrap" Margin="0,0,0,5" LineHeight="18"/>
                    <TextBlock Text="  你也可以在“定时截图”里启用自动去重功能" TextWrapping="Wrap" Margin="0,0,0,5" LineHeight="18"/>
                    <TextBlock Text="- “生成视频”会根据截图先后顺序生成视频，帧率会确定每秒使用多少截图" TextWrapping="Wrap" Margin="0,0,0,5" LineHeight="18"/>
                    <TextBlock Text="  注意，本功能需要 ffmpeg，你可以轻松在网上下载到 ffmpeg.exe" TextWrapping="Wrap" Margin="0,0,0,5" LineHeight="18"/>
                    <TextBlock Text="  下载后路径选择好 ffmpeg.exe 文件，留空则会尝试从系统 PATH 中查找 ffmpeg，配置好后就可以生成视频了" TextWrapping="Wrap" Margin="0,0,0,5" LineHeight="18"/>
                </StackPanel>
            </ScrollViewer>

            <TextBlock Grid.Row="2" Text="by ABShinri" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="#333C46" FontSize="11" Margin="0,14,0,0"/>
        </Grid>
    </Border>
</Window>