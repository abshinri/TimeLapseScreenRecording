<Window x:Class="TimeLapseScreenRecorder.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TimeLapse Screen Recorder"
    Width="840" Height="570"
    MinWidth="760" MinHeight="500"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    ResizeMode="CanResize"
    Background="#0B0D10"
    Foreground="#F4F7FB"
    BorderThickness="0"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    Icon="pack://application:,,,/assets/app.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="28" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="12"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="BgBase" Color="#0B0D10"/>
        <SolidColorBrush x:Key="BgPanel" Color="#12161A"/>
        <SolidColorBrush x:Key="BgSubtle" Color="#191E25"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#2B333C"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F4F7FB"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A4AFBA"/>
        <SolidColorBrush x:Key="Accent" Color="#7DA3FF"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#BFD3FF"/>
        <SolidColorBrush x:Key="ButtonBase" Color="#1A2128"/>
        <SolidColorBrush x:Key="ButtonHover" Color="#212A33"/>
        <SolidColorBrush x:Key="ButtonPressed" Color="#151C23"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#121820"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBoxBase">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer Margin="0" x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#171D24"/>
            <Setter Property="BorderBrush" Value="#2E3740"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#EAF1FA"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#DCE8F9" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#121820"/>
            <Setter Property="Foreground" Value="#EAF1FA"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D2834"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#243244"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonBase}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ButtonHover}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ButtonPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#BEC9D5"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="3" SnapsToDevicePixels="True">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1D232B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#141B20"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MinimizeTitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="3" SnapsToDevicePixels="True">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1D232B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#171D22"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseTitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Foreground" Value="#F1F5FA"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="3" SnapsToDevicePixels="True">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#D74545"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#BA3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1F2A39"/>
            <Setter Property="BorderBrush" Value="#5477D5"/>
            <Setter Property="Foreground" Value="{StaticResource AccentSoft}"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource BgBase}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#212933"/>
            <Setter Property="Margin" Value="8,8,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel x:Name="HeaderPanel" Grid.Row="0" IsItemsHost="True" Margin="8,8,8,0" KeyboardNavigation.TabIndex="1"/>
                            <Border Grid.Row="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="{TemplateBinding Background}" CornerRadius="8" Margin="0,6,0,0">
                                <ContentPresenter ContentSource="SelectedContent" Margin="0"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="#141A1F" BorderBrush="#212933" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0">
                            <ContentPresenter Margin="{TemplateBinding Padding}" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1C2430"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LogTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#141B20"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#DDE5EE"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
    </Window.Resources>

    <Grid Background="#0B0D10">
       <Grid.RowDefinitions>
           <RowDefinition Height="Auto"/>
           <RowDefinition Height="*"/>
       </Grid.RowDefinitions>

       <Border Grid.Row="0" Background="#0F1216" BorderBrush="#2A313A" BorderThickness="0,0,0,1" Height="26" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
           <Grid Margin="10,0,8,0">
               <Grid.ColumnDefinitions>
                   <ColumnDefinition Width="*"/>
                   <ColumnDefinition Width="Auto"/>
               </Grid.ColumnDefinitions>

               <TextBlock Text="TimeLapse Screen Recorder" FontWeight="SemiBold" Foreground="#D9DFE8" FontSize="11" VerticalAlignment="Center" Margin="0"/>

               <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
                   <Button x:Name="MinimizeButton" Content="—" Style="{StaticResource MinimizeTitleBarButtonStyle}" Margin="0,0,4,0" Click="MinimizeButton_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                   <Button x:Name="CloseButton" Content="×" Style="{StaticResource CloseTitleBarButtonStyle}" Click="CloseButton_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
               </StackPanel>
           </Grid>
       </Border>

       <TabControl Grid.Row="1" Margin="8,8,8,8">
           <TabItem Header="1. 定时截屏">
               <Grid Margin="18">
                   <Grid.RowDefinitions>
                       <RowDefinition Height="Auto"/>
                       <RowDefinition Height="Auto"/>
                       <RowDefinition Height="Auto"/>
                       <RowDefinition Height="Auto"/>
                       <RowDefinition Height="Auto"/>
                       <RowDefinition Height="Auto"/>
                       <RowDefinition Height="Auto"/>
                       <RowDefinition Height="Auto"/>
                       <RowDefinition Height="Auto"/>
                   </Grid.RowDefinitions>
                   <Grid.ColumnDefinitions>
                       <ColumnDefinition Width="110"/>
                       <ColumnDefinition Width="*"/>
                       <ColumnDefinition Width="150"/>
                   </Grid.ColumnDefinitions>

                   <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="保存文件夹" FontWeight="SemiBold" Margin="0,0,8,8"/>
                   <TextBox x:Name="CaptureFolderText" Grid.Row="0" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="0,0,8,10"/>
                   <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,10">
                       <Button x:Name="ChooseCaptureFolderButton" Width="70" Height="30" Content="浏览" Margin="0,0,6,0" Click="ChooseCaptureFolderButton_Click"/>
                       <Button x:Name="OpenCaptureFolderButton" Width="70" Height="30" Content="打开" Click="OpenCaptureFolderButton_Click"/>
                   </StackPanel>

                   <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="选择屏幕" FontWeight="SemiBold"/>
                   <ComboBox x:Name="MonitorComboBox" Grid.Row="1" Grid.Column="1" Height="30" Margin="0,0,10,10"/>

                   <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="截屏格式" FontWeight="SemiBold" Margin="0,0,8,8"/>
                   <ComboBox x:Name="CaptureFormatComboBox" Grid.Row="2" Grid.Column="1" Height="30" Margin="0,0,10,10" SelectedIndex="0"/>

                   <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="截图质量" FontWeight="SemiBold" Margin="0,0,8,8"/>
                   <ComboBox x:Name="CaptureQualityComboBox" Grid.Row="3" Grid.Column="1" Height="30" Margin="0,0,10,10" SelectedIndex="2"/>

                   <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="截屏间隔（秒）" FontWeight="SemiBold" Margin="0,0,8,8"/>
                   <TextBox x:Name="CaptureIntervalText" Grid.Row="4" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,10" Text="10"/>

                   <CheckBox x:Name="SkipUnchangedCaptureCheckBox" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,10" IsChecked="True" Content="无变化时不保存截图"/>
                   <CheckBox x:Name="ShowCaptureLogCheckBox" Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,10" IsChecked="False" Content="显示运行日志" Checked="ShowCaptureLogCheckBox_Checked" Unchecked="ShowCaptureLogCheckBox_Unchecked"/>

                   <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                       <Button x:Name="StartCaptureButton" Width="120" Height="36" Content="开始截屏" Margin="0,0,12,0" Click="StartCaptureButton_Click" Style="{StaticResource PrimaryActionButtonStyle}"/>
                       <Button x:Name="StopCaptureButton" Width="120" Height="36" Content="停止截屏" Click="StopCaptureButton_Click"/>
                   </StackPanel>

                   <TextBox x:Name="CaptureLogText" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="160" Height="110" Visibility="Collapsed"/>
               </Grid>
           </TabItem>

           <TabItem Header="2. 图片去重">
               <Grid Margin="18">
                   <Grid.RowDefinitions>
                       <RowDefinition Height="Auto"/>
                       <RowDefinition Height="Auto"/>
                       <RowDefinition Height="*"/>
                   </Grid.RowDefinitions>
                   <Grid.ColumnDefinitions>
                       <ColumnDefinition Width="110"/>
                       <ColumnDefinition Width="*"/>
                       <ColumnDefinition Width="150"/>
                   </Grid.ColumnDefinitions>

                   <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="图片文件夹" FontWeight="SemiBold" Margin="0,0,8,8"/>
                   <TextBox x:Name="DedupeFolderText" Grid.Row="0" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="0,0,8,10"/>
                   <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,10">
                       <Button x:Name="ChooseDedupeFolderButton" Width="70" Height="30" Content="浏览" Margin="0,0,6,0" Click="ChooseDedupeFolderButton_Click"/>
                       <Button x:Name="OpenDedupeFolderButton" Width="70" Height="30" Content="打开" Click="OpenDedupeFolderButton_Click"/>
                   </StackPanel>

                   <Button x:Name="RemoveDuplicatesButton" Grid.Row="1" Grid.Column="1" Width="180" Height="36" HorizontalAlignment="Left" Content="删除前后重复图片" Margin="0,0,0,12" Click="RemoveDuplicatesButton_Click" Style="{StaticResource PrimaryActionButtonStyle}"/>

                   <TextBox x:Name="DedupeLogText" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,0"/>
               </Grid>
           </TabItem>

           <TabItem Header="3. 生成视频">
               <Grid Margin="18">
                   <Grid.RowDefinitions>
                       <RowDefinition Height="Auto"/>
                       <RowDefinition Height="Auto"/>
                       <RowDefinition Height="Auto"/>
                       <RowDefinition Height="Auto"/>
                       <RowDefinition Height="Auto"/>
                       <RowDefinition Height="Auto"/>
                       <RowDefinition Height="*"/>
                   </Grid.RowDefinitions>
                   <Grid.ColumnDefinitions>
                       <ColumnDefinition Width="110"/>
                       <ColumnDefinition Width="*"/>
                       <ColumnDefinition Width="150"/>
                   </Grid.ColumnDefinitions>

                   <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="图片文件夹" FontWeight="SemiBold" Margin="0,0,8,8"/>
                   <TextBox x:Name="VideoFolderText" Grid.Row="0" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="0,0,8,10"/>
                   <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,10">
                       <Button x:Name="ChooseVideoFolderButton" Width="70" Height="30" Content="浏览" Margin="0,0,6,0" Click="ChooseVideoFolderButton_Click"/>
                       <Button x:Name="OpenVideoFolderButton" Width="70" Height="30" Content="打开" Click="OpenVideoFolderButton_Click"/>
                   </StackPanel>

                   <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="视频帧率" FontWeight="SemiBold" Margin="0,0,8,8"/>
                   <TextBox x:Name="VideoFpsText" Grid.Row="1" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,10" Text="10"/>

                   <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="ffmpeg 路径" FontWeight="SemiBold" Margin="0,0,8,8"/>
                   <TextBox x:Name="VideoFfmpegPathText" Grid.Row="2" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,10"/>
                   <Button x:Name="ChooseFfmpegFileButton" Grid.Row="2" Grid.Column="2" Height="30" Content="选择" Margin="0,0,0,10" Click="ChooseFfmpegFileButton_Click"/>

                   <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="输出目录" FontWeight="SemiBold" Margin="0,0,8,8"/>
                   <TextBox x:Name="VideoOutputDirectoryText" Grid.Row="3" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,10"/>
                   <Button x:Name="ChooseOutputDirectoryButton" Grid.Row="3" Grid.Column="2" Height="30" Content="目录" Margin="0,0,0,10" Click="ChooseOutputDirectoryButton_Click"/>

                   <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="输出文件名" FontWeight="SemiBold" Margin="0,0,8,8"/>
                   <TextBox x:Name="VideoOutputText" Grid.Row="4" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,10" Text="timelapse.mp4"/>
                   <Button x:Name="ChooseOutputFileButton" Grid.Row="4" Grid.Column="2" Height="30" Content="文件" Margin="0,0,0,10" Click="ChooseOutputFileButton_Click"/>

                   <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                       <Button x:Name="BuildVideoButton" Width="180" Height="36" Content="导出视频" Click="BuildVideoButton_Click" Style="{StaticResource PrimaryActionButtonStyle}"/>
                   </StackPanel>

                   <TextBox x:Name="VideoLogText" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,0"/>
               </Grid>
           </TabItem>
       </TabControl>
    </Grid>
</Window>
