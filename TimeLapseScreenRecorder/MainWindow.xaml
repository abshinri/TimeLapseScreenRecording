<Window x:Class="TimeLapseScreenRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimeLapse Screen Recorder"
        Width="980" Height="720"
        WindowStartupLocation="CenterScreen"
        Icon="assets/app.ico"
        >
    <TabControl Margin="12">
        <TabItem Header="1. 定时截屏">
           <Grid Margin="18">
               <Grid.RowDefinitions>
                   <RowDefinition Height="Auto"/>
                   <RowDefinition Height="Auto"/>
                   <RowDefinition Height="Auto"/>
                   <RowDefinition Height="Auto"/>
                   <RowDefinition Height="*"/>
               </Grid.RowDefinitions>
               <Grid.ColumnDefinitions>
                   <ColumnDefinition Width="140"/>
                   <ColumnDefinition Width="*"/>
                   <ColumnDefinition Width="120"/>
               </Grid.ColumnDefinitions>

               <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="保存文件夹" FontWeight="SemiBold"/>
               <TextBox x:Name="CaptureFolderText" Grid.Row="0" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,10"/>
               <Button x:Name="ChooseCaptureFolderButton" Grid.Row="0" Grid.Column="2" Height="30" Content="浏览" Margin="0,0,0,10" Click="ChooseCaptureFolderButton_Click"/>

               <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="选择屏幕" FontWeight="SemiBold"/>
               <ComboBox x:Name="MonitorComboBox" Grid.Row="1" Grid.Column="1" Height="30" Margin="0,0,10,10"/>

               <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="截屏间隔（秒）" FontWeight="SemiBold"/>
               <TextBox x:Name="CaptureIntervalText" Grid.Row="2" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,10" Text="10"/>

               <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,16">
                   <Button x:Name="StartCaptureButton" Width="120" Height="36" Content="开始截屏" Margin="0,0,12,0" Click="StartCaptureButton_Click"/>
                   <Button x:Name="StopCaptureButton" Width="120" Height="36" Content="停止截屏" Click="StopCaptureButton_Click"/>
               </StackPanel>

               <TextBox x:Name="CaptureLogText" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AcceptsReturn="True"/>
           </Grid>
        </TabItem>

        <TabItem Header="2. 图片去重">
           <Grid Margin="18">
               <Grid.RowDefinitions>
                   <RowDefinition Height="Auto"/>
                   <RowDefinition Height="Auto"/>
                   <RowDefinition Height="*"/>
               </Grid.RowDefinitions>
               <Grid.ColumnDefinitions>
                   <ColumnDefinition Width="160"/>
                   <ColumnDefinition Width="*"/>
                   <ColumnDefinition Width="120"/>
               </Grid.ColumnDefinitions>

               <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="图片文件夹" FontWeight="SemiBold"/>
               <TextBox x:Name="DedupeFolderText" Grid.Row="0" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,10"/>
               <Button x:Name="ChooseDedupeFolderButton" Grid.Row="0" Grid.Column="2" Height="30" Content="浏览" Margin="0,0,0,10" Click="ChooseDedupeFolderButton_Click"/>

               <Button x:Name="RemoveDuplicatesButton" Grid.Row="1" Grid.Column="1" Width="180" Height="36" HorizontalAlignment="Left" Content="删除前后重复图片" Margin="0,0,0,12" Click="RemoveDuplicatesButton_Click"/>

               <TextBox x:Name="DedupeLogText" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AcceptsReturn="True"/>
           </Grid>
        </TabItem>

        <TabItem Header="3. 生成视频">
           <Grid Margin="18">
               <Grid.RowDefinitions>
                   <RowDefinition Height="Auto"/>
                   <RowDefinition Height="Auto"/>
                   <RowDefinition Height="Auto"/>
                   <RowDefinition Height="Auto"/>
                   <RowDefinition Height="*"/>
               </Grid.RowDefinitions>
               <Grid.ColumnDefinitions>
                   <ColumnDefinition Width="160"/>
                   <ColumnDefinition Width="*"/>
                   <ColumnDefinition Width="120"/>
               </Grid.ColumnDefinitions>

               <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="图片文件夹" FontWeight="SemiBold"/>
               <TextBox x:Name="VideoFolderText" Grid.Row="0" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,10"/>
               <Button x:Name="ChooseVideoFolderButton" Grid.Row="0" Grid.Column="2" Height="30" Content="浏览" Margin="0,0,0,10" Click="ChooseVideoFolderButton_Click"/>

               <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="视频帧率" FontWeight="SemiBold"/>
               <TextBox x:Name="VideoFpsText" Grid.Row="1" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,10" Text="10"/>

               <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="ffmpeg 路径" FontWeight="SemiBold"/>
               <TextBox x:Name="VideoFfmpegPathText" Grid.Row="2" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,10"/>
               <Button x:Name="ChooseFfmpegFileButton" Grid.Row="2" Grid.Column="2" Height="30" Content="选择" Margin="0,0,0,10" Click="ChooseFfmpegFileButton_Click"/>

               <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="输出视频路径" FontWeight="SemiBold"/>
               <TextBox x:Name="VideoOutputText" Grid.Row="3" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,10"/>
               <Button x:Name="ChooseOutputFileButton" Grid.Row="3" Grid.Column="2" Height="30" Content="输出" Margin="0,0,0,10" Click="ChooseOutputFileButton_Click"/>

               <Button x:Name="BuildVideoButton" Grid.Row="4" Grid.Column="1" Width="180" Height="36" HorizontalAlignment="Left" Content="生成时间轴视频" Margin="0,0,0,12" Click="BuildVideoButton_Click"/>

               <TextBox x:Name="VideoLogText" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AcceptsReturn="True"/>
           </Grid>
        </TabItem>
    </TabControl>
</Window>
