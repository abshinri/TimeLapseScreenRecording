<Window x:Class="TimeLapseScreenRecorder.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TimeLapse Screen Recorder"
    Width="840" Height="600"
    MinWidth="780" MinHeight="540"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    ResizeMode="CanResize"
    Background="#0B0D10"
    Foreground="#EDF2F8"
    BorderThickness="0"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    Icon="pack://application:,,,/assets/app.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="BgBase" Color="#0B0D10"/>
        <SolidColorBrush x:Key="BgPanel" Color="#12161A"/>
        <SolidColorBrush x:Key="BgCard" Color="#141A21"/>
        <SolidColorBrush x:Key="BgInput" Color="#11161C"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#262E38"/>
        <SolidColorBrush x:Key="BorderStrong" Color="#313B46"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#EDF2F8"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#98A4B0"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B7684"/>
        <SolidColorBrush x:Key="Accent" Color="#7DA3FF"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#C4D5FF"/>
        <SolidColorBrush x:Key="ButtonBase" Color="#1B232C"/>
        <SolidColorBrush x:Key="ButtonHover" Color="#253039"/>
        <SolidColorBrush x:Key="ButtonPressed" Color="#131A21"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,10"/>
        </Style>        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBoxBase">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
                            <ScrollViewer Margin="0" x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Margin="11,0,0,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                <Path Grid.Column="1" Data="M0,0 L4.5,4.5 L9,0" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#171D24"/>
            <Setter Property="Foreground" Value="#E7EDF5"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F2933"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#263649"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" Background="#11161C" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center">
                                <Path x:Name="Check" Data="M2.5,8 L6,11.5 L13.5,4" Stroke="{StaticResource Accent}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonBase}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ButtonHover}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ButtonPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#22314A"/>
            <Setter Property="BorderBrush" Value="#5C7FD8"/>
            <Setter Property="Foreground" Value="{StaticResource AccentSoft}"/>
        </Style>        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#202730"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#151B21"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseTitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#C63B3B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#A63232"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource BgBase}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#20272F"/>
            <Setter Property="Margin" Value="12,8,12,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel x:Name="HeaderPanel" Grid.Row="0" IsItemsHost="True" Margin="12,10,12,0" KeyboardNavigation.TabIndex="1"/>
                            <Border Grid.Row="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="{TemplateBinding Background}" CornerRadius="10" Margin="0,0,0,0">
                                <ContentPresenter ContentSource="SelectedContent" Margin="0"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Margin="0,0,8,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="Bd" Grid.Row="0" Background="Transparent" CornerRadius="6,6,0,0" Padding="16,8">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Underline" Grid.Row="1" Height="2" CornerRadius="1" Background="{StaticResource Accent}" Margin="14,0,14,0" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#161C24"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Bd" Property="Background" Value="#141A21"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LogTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#11161C"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#CDD6E0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBoxBase">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
                            <ScrollViewer Margin="0" x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>    <Grid Background="{StaticResource BgBase}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0E1216" BorderBrush="#2A313A" BorderThickness="0,0,0,1" Height="26" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="14,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0">
                    <TextBlock Text="桌面延时录像工具" FontWeight="SemiBold" Foreground="#E3E9F1" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0">
                    <Button x:Name="HelpButton" Style="{StaticResource TitleBarButtonStyle}" Margin="0,0,2,0" Click="HelpButton_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="使用帮助">
                        <Grid>
                            <Ellipse Width="14" Height="14" Stroke="#9FB3C8" StrokeThickness="1.3"/>
                            <Path Data="M5.2,6.4 C5.2,5.4 6.0,4.6 7.0,4.6 C8.0,4.6 8.8,5.4 8.8,6.4 C8.8,7.6 7.0,7.7 7.0,8.6" Stroke="#9FB3C8" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Path Data="M7.0,10.6 L7.0,10.6" Stroke="#9FB3C8" StrokeThickness="1.3" StrokeStartLineCap="Round"/>
                        </Grid>
                    </Button>
                    <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButtonStyle}" Margin="0,0,2,0" Click="MinimizeButton_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="M0,0 L10,0" Stroke="#BAC5D1" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseTitleBarButtonStyle}" Click="CloseButton_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="M0,0 L9,10 M9,0 L0,10" Stroke="#E7EDF5" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>        <TabControl Grid.Row="1">
            <TabItem Header="定时截屏">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="108"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="156"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="保存文件夹"/>
                    <TextBox x:Name="CaptureFolderText" Grid.Row="0" Grid.Column="1" Height="34" VerticalContentAlignment="Center" Margin="0,0,8,10"/>
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="ChooseCaptureFolderButton" Width="72" Height="34" Content="浏览" Margin="0,0,8,0" Click="ChooseCaptureFolderButton_Click"/>
                        <Button x:Name="OpenCaptureFolderButton" Width="72" Height="34" Content="打开" Click="OpenCaptureFolderButton_Click"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="选择屏幕"/>
                    <ComboBox x:Name="MonitorComboBox" Grid.Row="1" Grid.Column="1" Height="34" Margin="0,0,10,10"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="截屏格式"/>
                    <ComboBox x:Name="CaptureFormatComboBox" Grid.Row="2" Grid.Column="1" Height="34" Margin="0,0,10,10" SelectedIndex="0"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="截图质量"/>
                    <ComboBox x:Name="CaptureQualityComboBox" Grid.Row="3" Grid.Column="1" Height="34" Margin="0,0,10,10" SelectedIndex="2"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="截屏间隔（秒）"/>
                    <TextBox x:Name="CaptureIntervalText" Grid.Row="4" Grid.Column="1" Height="34" VerticalContentAlignment="Center" Margin="0,0,10,10" Text="10"/>

                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,14" VerticalAlignment="Center">
                        <CheckBox x:Name="SkipUnchangedCaptureCheckBox" IsChecked="True" Content="无变化时不保存截图" VerticalAlignment="Center" Margin="0,0,28,0"/>
                        <CheckBox x:Name="ShowCaptureLogCheckBox" IsChecked="False" Content="显示运行日志" VerticalAlignment="Center" Margin="0" Checked="ShowCaptureLogCheckBox_Checked" Unchecked="ShowCaptureLogCheckBox_Unchecked"/>
                    </StackPanel>
                    <Grid Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource BgCard}" BorderBrush="#242C35" BorderThickness="1" CornerRadius="10" Padding="16,10" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox x:Name="FocusTimerCheckBox" Grid.Column="0" Content="启用计时" VerticalAlignment="Center" Margin="0,0,0,0" Checked="FocusTimerCheckBox_Checked" Unchecked="FocusTimerCheckBox_Unchecked"/>
                                <TextBlock x:Name="FocusTimerText" Grid.Column="1" Text="00:00:00" Foreground="#9DBBFF" FontSize="22" FontFamily="Consolas" FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,0,0,0"/>
                                <Border x:Name="FocusTimerStatusPill" Grid.Column="2" Background="#161C24" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="5" Padding="8,2" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock x:Name="FocusTimerStatusText" Text="未启用" Foreground="{StaticResource TextMuted}" FontSize="10" VerticalAlignment="Center"/>
                                </Border>
                                <Button x:Name="ResetFocusTimerButton" Grid.Column="3" Content="重置计时" Width="86" Height="34" VerticalAlignment="Center" Margin="16,0,0,0" Click="ResetFocusTimerButton_Click"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="StartCaptureButton" Width="110" Height="38" Content="开始截屏" Margin="0,0,12,0" Click="StartCaptureButton_Click" Style="{StaticResource PrimaryActionButtonStyle}"/>
                            <Button x:Name="StopCaptureButton" Width="110" Height="38" Content="停止截屏" Click="StopCaptureButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <TextBox x:Name="CaptureLogText" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" IsReadOnly="True" Style="{StaticResource LogTextBoxStyle}" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="150" Height="110" Visibility="Collapsed"/>
                </Grid>
            </TabItem>            <TabItem Header="图片去重">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="108"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="156"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="图片文件夹"/>
                    <TextBox x:Name="DedupeFolderText" Grid.Row="0" Grid.Column="1" Height="34" VerticalContentAlignment="Center" Margin="0,0,8,10"/>
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="ChooseDedupeFolderButton" Width="72" Height="34" Content="浏览" Margin="0,0,8,0" Click="ChooseDedupeFolderButton_Click"/>
                        <Button x:Name="OpenDedupeFolderButton" Width="72" Height="34" Content="打开" Click="OpenDedupeFolderButton_Click"/>
                    </StackPanel>

                    <Button x:Name="RemoveDuplicatesButton" Grid.Row="1" Grid.Column="1" Width="184" Height="38" HorizontalAlignment="Left" Content="删除前后重复图片" Margin="0,0,0,12" Click="RemoveDuplicatesButton_Click" Style="{StaticResource PrimaryActionButtonStyle}"/>

                    <TextBox x:Name="DedupeLogText" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" IsReadOnly="True" Style="{StaticResource LogTextBoxStyle}" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,0"/>
                </Grid>
            </TabItem>            <TabItem Header="生成视频">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="108"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="156"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="图片文件夹"/>
                    <TextBox x:Name="VideoFolderText" Grid.Row="0" Grid.Column="1" Height="34" VerticalContentAlignment="Center" Margin="0,0,8,10"/>
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="ChooseVideoFolderButton" Width="72" Height="34" Content="浏览" Margin="0,0,8,0" Click="ChooseVideoFolderButton_Click"/>
                        <Button x:Name="OpenVideoFolderButton" Width="72" Height="34" Content="打开" Click="OpenVideoFolderButton_Click"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="视频帧率"/>
                    <TextBox x:Name="VideoFpsText" Grid.Row="1" Grid.Column="1" Height="34" VerticalContentAlignment="Center" Margin="0,0,10,10" Text="10"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="ffmpeg 路径"/>
                    <TextBox x:Name="VideoFfmpegPathText" Grid.Row="2" Grid.Column="1" Height="34" VerticalContentAlignment="Center" Margin="0,0,10,10"/>
                    <Button x:Name="ChooseFfmpegFileButton" Grid.Row="2" Grid.Column="2" Height="34" Content="选择" Margin="0,0,0,10" Click="ChooseFfmpegFileButton_Click"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="输出目录"/>
                    <TextBox x:Name="VideoOutputDirectoryText" Grid.Row="3" Grid.Column="1" Height="34" VerticalContentAlignment="Center" Margin="0,0,10,10"/>
                    <Button x:Name="ChooseOutputDirectoryButton" Grid.Row="3" Grid.Column="2" Height="34" Content="目录" Margin="0,0,0,10" Click="ChooseOutputDirectoryButton_Click"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="输出文件名"/>
                    <TextBox x:Name="VideoOutputText" Grid.Row="4" Grid.Column="1" Height="34" VerticalContentAlignment="Center" Margin="0,0,10,10" Text="timelapse.mp4"/>
                    <Button x:Name="ChooseOutputFileButton" Grid.Row="4" Grid.Column="2" Height="34" Content="文件" Margin="0,0,0,10" Click="ChooseOutputFileButton_Click"/>

                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="BuildVideoButton" Width="184" Height="38" Content="导出视频" Click="BuildVideoButton_Click" Style="{StaticResource PrimaryActionButtonStyle}"/>
                    </StackPanel>

                    <TextBox x:Name="VideoLogText" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" IsReadOnly="True" Style="{StaticResource LogTextBoxStyle}" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,0"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>